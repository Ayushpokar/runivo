generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model bookmarks {
  user_id    BigInt
  problem_id BigInt
  created_at DateTime @default(now()) @db.Timestamptz(6)
  problems   problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, problem_id])
}

model examples {
  id             BigInt   @id @default(autoincrement())
  problem_id     BigInt
  example_input  String
  example_output String
  explanation    String?
  position       Int      @default(1)
  problems       problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model hints {
  id               BigInt   @id @default(autoincrement())
  problem_id       BigInt
  hint_description String
  hint_level       Int      @default(1)
  problems         problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notes {
  id                BigInt   @id @default(autoincrement())
  user_id           BigInt
  problem_id        BigInt
  notes_description String   @default("")
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  problems          problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, problem_id])
}

model problem_constraints {
  id              BigInt   @id @default(autoincrement())
  problem_id      BigInt
  constraint_text String
  problems        problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model problem_tags {
  problem_id BigInt
  tag_id     BigInt
  problems   problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags     @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([problem_id, tag_id])
  @@index([tag_id, problem_id], map: "idx_problem_tags_tag")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model problems {
  id                  BigInt                @id @default(autoincrement())
  title               String                @unique(map: "uq_problems_title") @db.VarChar(200)
  difficulty          String                @db.VarChar(10)
  description         String
  input_format        String?
  output_format       String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  bookmarks           bookmarks[]
  examples            examples[]
  hints               hints[]
  notes               notes[]
  problem_constraints problem_constraints[]
  problem_tags        problem_tags[]
  submissions         submissions[]
  test_cases          test_cases[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model submissions {
  id                BigInt    @id @default(autoincrement())
  problem_id        BigInt
  user_id           BigInt
  source_code       String
  language          String    @default("python") @db.VarChar(30)
  status            String    @default("QUEUED") @db.VarChar(20)
  verdict           String?   @db.VarChar(30)
  execution_time_ms Int?
  memory_used_kb    Int?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  completed_at      DateTime? @db.Timestamptz(6)
  problems          problems  @relation(fields: [problem_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users             users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([problem_id, user_id], map: "idx_submissions_problem_user")
  @@index([user_id, created_at(sort: Desc)], map: "idx_submissions_user_created")
}

model tags {
  id           BigInt         @id @default(autoincrement())
  name         String         @unique @db.VarChar(50)
  problem_tags problem_tags[]
}

model test_cases {
  id              BigInt   @id @default(autoincrement())
  problem_id      BigInt
  input_data      String
  expected_output String
  is_sample       Boolean  @default(false)
  position        Int      @default(1)
  problems        problems @relation(fields: [problem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([problem_id, position], map: "idx_test_cases_problem")
}

model users {
  id            BigInt        @id @default(autoincrement())
  username      String        @unique @db.VarChar(50)
  name          String        @db.VarChar(100)
  email         String        @unique @db.VarChar(255)
  password_hash String
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  bookmarks     bookmarks[]
  notes         notes[]
  submissions   submissions[]
}
